# 复制为 .env 后填写本机七牛云配置，禁止在示例文件中填写真实密钥。
# JWT 签名密钥（仅示例值；生产环境必须使用 Secret/环境变量注入随机密钥）
PASSENGER_TOKEN_SIGNING_KEY=replace-with-a-random-signing-key
PASSENGER_QINIU_ACCESS_KEY=your-access-key
PASSENGER_QINIU_SECRET_KEY=your-secret-key
PASSENGER_QINIU_BUCKET=your-bucket-name
PASSENGER_QINIU_DOMAIN=http://your-cdn-domain.example.com
PASSENGER_QINIU_UPLOAD_URL=https://upload.qiniup.com
