syntax = "v1"

info (
	title:  "driver api"
	desc:   "driver-side HTTP API"
	author: "XiaoLong-Ridy"
)

type Response {
	Code      int    `json:"code"`
	Message   string `json:"message"`
	Data      any    `json:"data"`
	Timestamp int64  `json:"timestamp"`
	TraceID   string `json:"traceId"`
}

type RegisterDriverRequest {
	Phone           string `json:"phone"`
	Password        string `json:"password"`
	RealName        string `json:"realName"`
	IdCardNo        string `json:"idCardNo"`
	DriverLicenseNo string `json:"driverLicenseNo"`
	AvatarURL       string `json:"avatarUrl"`
}

type RegisterDriverResponse {
	ID        int64  `json:"id"`
	Status    string `json:"status"`
	CreatedAt int64  `json:"createdAt"`
}

type CreateDriverRequest {
	Phone           string `json:"phone"`
	Password        string `json:"password"`
	RealName        string `json:"realName"`
	IdCardNo        string `json:"idCardNo"`
	DriverLicenseNo string `json:"driverLicenseNo"`
	AvatarURL       string `json:"avatarUrl"`
}

type CreateDriverResponse {
	ID        int64  `json:"id"`
	Status    string `json:"status"`
	CreatedAt int64  `json:"createdAt"`
}

type UpdateDriverRequest {
	ID              int64   `json:"id"`
	Phone           *string `json:"phone,omitempty"`
	Password        *string `json:"password,omitempty"`
	RealName        *string `json:"realName,omitempty"`
	IdCardNo        *string `json:"idCardNo,omitempty"`
	DriverLicenseNo *string `json:"driverLicenseNo,omitempty"`
	AvatarURL       *string `json:"avatarUrl,omitempty"`
	Status          *string `json:"status,omitempty"`
}

type UpdateDriverResponse {
	ID        int64  `json:"id"`
	Status    string `json:"status"`
	UpdatedAt int64  `json:"updatedAt"`
}

type GetDriverRequest {
	ID int64 `form:"id"`
}

type DriverDetail {
	ID              int64  `json:"id"`
	Phone           string `json:"phone"`
	RealName        string `json:"realName"`
	IdCardNo        string `json:"idCardNo"`
	DriverLicenseNo string `json:"driverLicenseNo"`
	AvatarURL       string `json:"avatarUrl"`
	Status          string `json:"status"`
	OnlineStatus    int    `json:"onlineStatus"`
	CreatedAt       int64  `json:"createdAt"`
	UpdatedAt       int64  `json:"updatedAt"`
}

type GetDriverResponse {
	Driver DriverDetail `json:"driver"`
}

type DeleteDriverRequest {
	ID int64 `form:"id"`
}

type DeleteResponse {
	ID      int64 `json:"id"`
	Success bool  `json:"success"`
}

type SendSMSCodeRequest {
	Phone string `json:"phone"`
}

type SendSMSCodeResponse {
	Success  bool `json:"success"`
	ExpireIn int  `json:"expireIn"`
}

type LoginByPasswordRequest {
	Phone    string `json:"phone"`
	Password string `json:"password"`
}

type LoginBySMSRequest {
	Phone string `json:"phone"`
	Code  string `json:"code"`
}

type DriverBrief {
	ID     int64  `json:"id"`
	Phone  string `json:"phone"`
	Status string `json:"status"`
}

type LoginResponse {
	Token    string      `json:"token"`
	ExpireIn int64       `json:"expireIn"`
	Driver   DriverBrief `json:"driver"`
}

type SetOnlineRequest {
	DeviceID  string  `json:"deviceId"`
	Longitude float64 `json:"longitude"`
	Latitude  float64 `json:"latitude"`
}

type SetOfflineRequest {
	DeviceID  string  `json:"deviceId"`
	Longitude float64 `json:"longitude"`
	Latitude  float64 `json:"latitude"`
}

type SetOnlineResponse {
	DriverID     int64 `json:"driverId"`
	OnlineStatus int   `json:"onlineStatus"`
	Kicked       bool  `json:"kicked"`
}

type SetOfflineResponse {
	DriverID     int64 `json:"driverId"`
	OnlineStatus int   `json:"onlineStatus"`
	Kicked       bool  `json:"kicked"`
}

type HeartbeatRequest {
	DeviceID  string  `json:"deviceId"`
	Longitude float64 `json:"longitude"`
	Latitude  float64 `json:"latitude"`
}

type HeartbeatResponse {
	OnlineStatus int   `json:"onlineStatus"`
	Kicked       bool  `json:"kicked"`
	ServerTime   int64 `json:"serverTime"`
}

type ReportLocationRequest {
	DeviceID  string  `json:"deviceId"`
	Longitude float64 `json:"longitude"`
	Latitude  float64 `json:"latitude"`
}

type ReportLocationResponse {
	DriverID     int64 `json:"driverId"`
	OnlineStatus int   `json:"onlineStatus"`
	Kicked       bool  `json:"kicked"`
	ReportTime   int64 `json:"reportTime"`
}

type AiScoreFactor {
	Key    string  `json:"key"`
	Label  string  `json:"label"`
	Value  float64 `json:"value"`
	Impact string  `json:"impact"`
	Hint   string  `json:"hint"`
}

type GetDriverAiScoreRequest {
	DriverID int64 `form:"id"`
}

type GetDriverAiScoreResponse {
	DriverID      int64           `json:"driverId"`
	AiScore       float64         `json:"aiScore"`
	Level         int32           `json:"level"`
	Factors       []AiScoreFactor `json:"factors"`
	Degraded      bool            `json:"degraded"`
	DegradeReason string          `json:"degradeReason"`
}

type UploadCertificationRequest {
	VehicleID      int64  `json:"vehicleId"`
	IdCardFront    string `json:"idCardFront"`
	IdCardBack     string `json:"idCardBack"`
	DriverLicense  string `json:"driverLicense"`
	VehicleLicense string `json:"vehicleLicense"`
}

type CertificationInfo {
	ID                int64  `json:"id"`
	DriverID          int64  `json:"driverId"`
	VehicleID         int64  `json:"vehicleId"`
	IdCardFrontURL    string `json:"idCardFrontUrl"`
	IdCardBackURL     string `json:"idCardBackUrl"`
	DriverLicenseURL  string `json:"driverLicenseUrl"`
	VehicleLicenseURL string `json:"vehicleLicenseUrl"`
	AuditStatus       int    `json:"auditStatus"`
	AuditRemark       string `json:"auditRemark"`
}

type UploadCertificationResponse {
	ID            int64              `json:"id"`
	Certification *CertificationInfo `json:"certification"`
}

type GetCertificationResponse {
	Certification *CertificationInfo `json:"certification"`
	Found         bool               `json:"found"`
}

type AcceptOrderRequest {
	OrderID int64 `json:"orderId"`
}

type AcceptOrderResponse {
	OrderID int64 `json:"orderId"`
	Status  int32 `json:"status"`
}

type ConfirmArriveRequest {
	OrderID int64 `json:"orderId"`
}

type ConfirmArriveResponse {
	OrderID int64 `json:"orderId"`
	Status  int32 `json:"status"`
}

type StartTripRequest {
	OrderID int64 `json:"orderId"`
}

type StartTripResponse {
	OrderID int64 `json:"orderId"`
	Status  int32 `json:"status"`
}

type FinishTripRequest {
	OrderID          int64 `json:"orderId"`
	ActualDistanceM  int64 `json:"actualDistanceM"`
	ActualDurationS  int64 `json:"actualDurationS"`
	ActualPriceCents int64 `json:"actualPriceCents"`
}

type FinishTripResponse {
	OrderID            int64 `json:"orderId"`
	Status             int32 `json:"status"`
	PayableAmountCents int64 `json:"payableAmountCents"`
}

type RejectOrderRequest {
	OrderID int64  `json:"orderId"`
	Reason  string `json:"reason"`
}

type RejectOrderResponse {
	OrderID  int64 `json:"orderId"`
	DriverID int64 `json:"driverId"`
	Status   int32 `json:"status"`
}

type ListMyDispatchesRequest {
	Page     int32 `json:"page"`
	PageSize int32 `json:"pageSize"`
	Status   int32 `json:"status"`
}

type DispatchRecord {
	ID           int64   `json:"id"`
	OrderID      int64   `json:"orderId"`
	DriverID     int64   `json:"driverId"`
	DispatchType int32   `json:"dispatchType"`
	Status       int32   `json:"status"`
	MatchScore   float64 `json:"matchScore"`
	Remark       string  `json:"remark"`
	CreatedAt    int64   `json:"createdAt"`
	UpdatedAt    int64   `json:"updatedAt"`
}

type OrderBrief {
	OrderID             int64  `json:"orderId"`
	OrderNo             string `json:"orderNo"`
	FromAddress         string `json:"fromAddress"`
	ToAddress           string `json:"toAddress"`
	Status              int32  `json:"status"`
	EstimatedPriceCents int64  `json:"estimatedPriceCents"`
	CreatedAt           int64  `json:"createdAt"`
}

type MyDispatchItem {
	Dispatch DispatchRecord `json:"dispatch"`
	Order    OrderBrief     `json:"order"`
}

type ListMyDispatchesResponse {
	List     []MyDispatchItem `json:"list"`
	Total    int64            `json:"total"`
	Page     int32            `json:"page"`
	PageSize int32            `json:"pageSize"`
}

type AgentChatRequest {
	Question string `json:"question"`
}

type AgentObservation {
	ToolName string `json:"toolName"`
	Result   string `json:"result"`
}

type AgentChatResponse {
	Answer       string             `json:"answer"`
	LoopCount    int                `json:"loopCount"`
	Observations []AgentObservation `json:"observations"`
	Mode         string             `json:"mode"`
}

service driver-api {
	@handler SendSMSCodeHandler
	post /api/driver/v1/auth/send-sms-code (SendSMSCodeRequest) returns (SendSMSCodeResponse)

	@handler LoginByPasswordHandler
	post /api/driver/v1/auth/login-by-password (LoginByPasswordRequest) returns (LoginResponse)

	@handler LoginBySMSHandler
	post /api/driver/v1/auth/login-by-sms (LoginBySMSRequest) returns (LoginResponse)

	@handler RegisterDriverHandler
	post /api/driver/v1/drivers/register (RegisterDriverRequest) returns (RegisterDriverResponse)

	@handler CreateDriverHandler
	post /api/driver/v1/drivers (CreateDriverRequest) returns (CreateDriverResponse)

	@handler UpdateDriverHandler
	post /api/driver/v1/drivers/update (UpdateDriverRequest) returns (UpdateDriverResponse)

	@handler GetDriverHandler
	get /api/driver/v1/drivers/get (GetDriverRequest) returns (GetDriverResponse)

	@handler DeleteDriverHandler
	post /api/driver/v1/drivers/delete (DeleteDriverRequest) returns (DeleteResponse)

	@handler GetDriverAiScoreHandler
	get /api/driver/v1/drivers/ai-score (GetDriverAiScoreRequest) returns (GetDriverAiScoreResponse)

	@handler SetOnlineHandler
	post /api/driver/v1/drivers/online (SetOnlineRequest) returns (SetOnlineResponse)

	@handler SetOfflineHandler
	post /api/driver/v1/drivers/offline (SetOfflineRequest) returns (SetOfflineResponse)

	@handler HeartbeatHandler
	post /api/driver/v1/drivers/heartbeat (HeartbeatRequest) returns (HeartbeatResponse)

	@handler ReportLocationHandler
	post /api/driver/v1/drivers/location/report (ReportLocationRequest) returns (ReportLocationResponse)

	@handler UploadCertificationHandler
	post /api/driver/v1/drivers/certification/upload (UploadCertificationRequest) returns (UploadCertificationResponse)

	@handler GetCertificationHandler
	get /api/driver/v1/drivers/certification returns (GetCertificationResponse)

	@handler AcceptOrderHandler
	post /api/driver/v1/orders/accept (AcceptOrderRequest) returns (AcceptOrderResponse)

	@handler RejectOrderHandler
	post /api/driver/v1/orders/reject (RejectOrderRequest) returns (RejectOrderResponse)

	@handler ListMyDispatchesHandler
	post /api/driver/v1/orders/dispatches (ListMyDispatchesRequest) returns (ListMyDispatchesResponse)

	@handler StartTripHandler
	post /api/driver/v1/orders/start-trip (StartTripRequest) returns (StartTripResponse)

	@handler ConfirmArriveHandler
	post /api/driver/v1/orders/confirm-arrive (ConfirmArriveRequest) returns (ConfirmArriveResponse)

	@handler FinishTripHandler
	post /api/driver/v1/orders/finish-trip (FinishTripRequest) returns (FinishTripResponse)

	@handler AgentChatHandler
	post /api/driver/v1/agent/chat (AgentChatRequest) returns (AgentChatResponse)
}
