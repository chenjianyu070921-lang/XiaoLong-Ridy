syntax = "v1"

info (
	title: "driver api"
	desc: "司机端 HTTP API，封装 driversvc gRPC 接口"
	author: "XiaoLong-Ridy"
)

// 通用约定：
// - 写接口使用 POST + JSON 请求体；查询/删除接口使用 GET/POST + 路径后缀，id 通过 ?id= 传递。
// - 所有响应统一为 { code, message, data, timestamp, traceId }。
// - 入参校验失败返回 HTTP 400 + code 50000，并携带具体中文错误信息。

// ============ 司机 ============
type CreateDriverRequest {
	Phone           string `json:"phone"`
	PasswordHash    string `json:"passwordHash"`
	RealName        string `json:"realName"`
	IdCardNo        string `json:"idCardNo"`
	DriverLicenseNo string `json:"driverLicenseNo"`
	AvatarURL       string `json:"avatarUrl"`
}

type CreateDriverResponse {
	ID        int64  `json:"id"`
	Status    string `json:"status"`
	CreatedAt int64  `json:"createdAt"`
}

// ============ 车辆 ============
type CreateVehicleRequest {
	DriverID          int64  `json:"driverId"`
	PlateNo           string `json:"plateNo"`
	Brand             string `json:"brand"`
	Model             string `json:"model"`
	Color             string `json:"color"`
	VehicleType       int32  `json:"vehicleType"`
	RegistrationDate  string `json:"registrationDate"`
	InsuranceNo       string `json:"insuranceNo"`
	InsuranceExpireAt string `json:"insuranceExpireAt"`
}

type CreateVehicleResponse {
	ID     int64 `json:"id"`
	Status int32 `json:"status"`
}

// ============ 认证 ============
type CreateCertificationRequest {
	DriverID          int64  `json:"driverId"`
	VehicleID         int64  `json:"vehicleId"`
	IdCardFrontURL    string `json:"idCardFrontUrl"`
	IdCardBackURL     string `json:"idCardBackUrl"`
	DriverLicenseURL  string `json:"driverLicenseUrl"`
	VehicleLicenseURL string `json:"vehicleLicenseUrl"`
}

type CreateCertificationResponse {
	ID         int64 `json:"id"`
	AuditStatus int32 `json:"auditStatus"`
}

// ============ 服务分 ============
type CreateScoreRequest {
	DriverID            int64   `json:"driverId"`
	Score               float64 `json:"score"`
	Level               int32   `json:"level"`
	MonthOrders         int32   `json:"monthOrders"`
	MonthCancelRate     float64 `json:"monthCancelRate"`
	MonthComplaintCount int32   `json:"monthComplaintCount"`
}

type CreateScoreResponse {
	ID       int64 `json:"id"`
	DriverID int64 `json:"driverId"`
}

// ============ 提现 ============
type CreateWithdrawRequest {
	DriverID   int64   `json:"driverId"`
	WithdrawNo string  `json:"withdrawNo"`
	Amount     float64 `json:"amount"`
	PayeeName  string  `json:"payeeName"`
	PayAccount string  `json:"payAccount"`
}

type CreateWithdrawResponse {
	ID         int64  `json:"id"`
	WithdrawNo string `json:"withdrawNo"`
	Status     int32  `json:"status"`
}

service driver-api {
	@handler CreateDriverHandler
	post /api/driver/v1/drivers (CreateDriverRequest) returns (CreateDriverResponse)

	@handler CreateVehicleHandler
	post /api/driver/v1/vehicles (CreateVehicleRequest) returns (CreateVehicleResponse)

	@handler CreateCertificationHandler
	post /api/driver/v1/certifications (CreateCertificationRequest) returns (CreateCertificationResponse)

	@handler CreateScoreHandler
	post /api/driver/v1/scores (CreateScoreRequest) returns (CreateScoreResponse)

	@handler CreateWithdrawHandler
	post /api/driver/v1/withdraws (CreateWithdrawRequest) returns (CreateWithdrawResponse)
}
