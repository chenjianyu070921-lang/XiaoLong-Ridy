{
  "openapi": "3.0.3",
  "info": {
    "title": "花小猪打车（仿）- 管理后台 API",
    "version": "1.0.0",
    "description": "模块三管理后台接口定义。基础路径 /admin/v1。除 login/register 外均需 Authorization: Bearer <token>。统一响应 {code,message,data}，code=0 表示成功。"
  },
  "servers": [
    { "url": "http://127.0.0.1:8083", "description": "本地 api/admin 网关" }
  ],
  "tags": [
    { "name": "基础", "description": "健康检查" },
    { "name": "鉴权", "description": "注册/登录/登出/当前账号/菜单" },
    { "name": "操作日志", "description": "后台操作日志查询" },
    { "name": "用户管理", "description": "用户列表/详情/冻结/解冻" },
    { "name": "司机审核", "description": "司机资质认证审核" },
    { "name": "订单管理", "description": "订单列表/详情/异常/取消" },
    { "name": "优惠券", "description": "优惠券模板与发券" },
    { "name": "计价规则", "description": "计价规则查询、新增、编辑、启停" },
    { "name": "营销活动", "description": "活动配置与发布" },
    { "name": "数据统计", "description": "运营/订单/优惠券统计" },
    { "name": "导出任务", "description": "导出任务创建与查询" },
    { "name": "风控", "description": "黑名单与命中记录" }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["基础"],
        "summary": "健康检查",
        "security": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "example": { "code": 0, "message": "ok" } } }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["基础"],
        "summary": "服务信息",
        "security": [],
        "responses": { "200": { "description": "服务信息" } }
      }
    },
    "/admin/v1/auth/register": {
      "post": {
        "tags": ["鉴权"],
        "summary": "管理员注册（首个管理员免 token，之后需超管）",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": { "username": "admin", "password": "123456", "real_name": "系统管理员", "role": 1 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "token": "xxxx", "expires_in": 86400, "admin": { "id": 1, "username": "admin", "real_name": "系统管理员", "role": 1, "status": 1 } } } } }
          },
          "400": { "description": "参数错误 40001" },
          "401": { "description": "已有管理员且未携带超管 token 40004" },
          "409": { "description": "用户名已存在 40902" }
        }
      }
    },
    "/admin/v1/auth/login": {
      "post": {
        "tags": ["鉴权"],
        "summary": "管理员登录",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "username": "admin", "password": "123456" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功，返回 token",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "token": "xxxx", "expires_in": 86400, "admin": { "id": 1, "username": "admin", "real_name": "系统管理员", "role": 1, "status": 1 } } } } }
          },
          "400": { "description": "请求体为空 40001" },
          "401": { "description": "账号或密码错误 40004" }
        }
      }
    },
    "/admin/v1/auth/logout": {
      "post": {
        "tags": ["鉴权"],
        "summary": "管理员退出（token 立即失效）",
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "message": "ok" } } } } }
        }
      }
    },
    "/admin/v1/auth/me": {
      "get": {
        "tags": ["鉴权"],
        "summary": "当前管理员信息",
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "admin": { "id": 1, "username": "admin", "real_name": "系统管理员", "role": 1, "status": 1 } } } } }
          },
          "401": { "description": "token 缺失或失效 40004" }
        }
      }
    },
    "/admin/v1/menus": {
      "get": {
        "tags": ["鉴权"],
        "summary": "当前角色菜单权限",
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "items": [ { "name": "工作台", "path": "/dashboard", "perm": "dashboard:view" } ] } } } }
          }
        }
      }
    },
    "/admin/v1/operation-logs": {
      "get": {
        "tags": ["操作日志"],
        "summary": "操作日志列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "admin_id", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "module", "in": "query", "schema": { "type": "string" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "target_type", "in": "query", "schema": { "type": "string" } },
          { "name": "target_id", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "start_time", "in": "query", "schema": { "type": "string", "example": "2026-08-01 00:00:00" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string", "example": "2026-08-18 23:59:59" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "list": [], "total": 0, "page": 1, "page_size": 20 } } } }
          }
        }
      }
    },
    "/admin/v1/users": {
      "get": {
        "tags": ["用户管理"],
        "summary": "用户列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string", "description": "手机号/昵称/真实姓名" } },
          { "name": "status", "in": "query", "schema": { "type": "integer", "description": "1 正常 2 冻结" } },
          { "name": "start_time", "in": "query", "schema": { "type": "string" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "list": [ { "id": 1, "phone": "19852186366", "nickname": "198****6366", "status": 1 } ], "total": 1, "page": 1, "page_size": 20 } } } }
          }
        }
      }
    },
    "/admin/v1/users/{id}": {
      "get": {
        "tags": ["用户管理"],
        "summary": "用户详情",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "成功" },
          "404": { "description": "资源不存在 40401" }
        }
      }
    },
    "/admin/v1/users/{id}/freeze": {
      "post": {
        "tags": ["用户管理"],
        "summary": "冻结用户",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FreezeRequest" },
              "example": { "reason": "异常下单", "remark": "同设备高频取消订单" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "message": "ok" } } } } },
          "404": { "description": "用户不存在 40401" }
        }
      }
    },
    "/admin/v1/users/{id}/unfreeze": {
      "post": {
        "tags": ["用户管理"],
        "summary": "解冻用户",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FreezeRequest" },
              "example": { "reason": "人工复核通过", "remark": "风险解除" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功" },
          "404": { "description": "用户不存在 40401" }
        }
      }
    },
    "/admin/v1/driver-certifications": {
      "get": {
        "tags": ["司机审核"],
        "summary": "司机认证审核列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string", "description": "司机手机号/姓名/车牌号" } },
          { "name": "audit_status", "in": "query", "schema": { "type": "integer", "description": "1 待审核 2 通过 3 驳回" } },
          { "name": "start_time", "in": "query", "schema": { "type": "string" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "list": [], "total": 0, "page": 1, "page_size": 20 } } } }
          }
        }
      }
    },
    "/admin/v1/driver-certifications/{id}": {
      "get": {
        "tags": ["司机审核"],
        "summary": "司机认证详情",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "成功" },
          "404": { "description": "资源不存在 40401" }
        }
      }
    },
    "/admin/v1/driver-certifications/{id}/approve": {
      "post": {
        "tags": ["司机审核"],
        "summary": "审核通过（联动激活司机与车辆）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuditRequest" },
              "example": { "remark": "资料齐全，审核通过" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "message": "ok" } } } } },
          "400": { "description": "已审核过 40001" },
          "404": { "description": "认证不存在 40401" }
        }
      }
    },
    "/admin/v1/driver-certifications/{id}/reject": {
      "post": {
        "tags": ["司机审核"],
        "summary": "审核驳回",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuditRequest" },
              "example": { "remark": "身份证照片不清晰，请重新上传" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功" },
          "400": { "description": "已审核过 40001" },
          "404": { "description": "认证不存在 40401" }
        }
      }
    },
    "/admin/v1/orders": {
      "get": {
        "tags": ["订单管理"],
        "summary": "订单列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string", "description": "订单号" } },
          { "name": "status", "in": "query", "schema": { "type": "integer", "description": "1 待接单 2 已接单 3 行程中 4 待支付 5 已完成 6 已取消" } },
          { "name": "user_id", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "driver_id", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "start_time", "in": "query", "schema": { "type": "string" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "list": [ { "id": 8, "order_no": "DD20260818155131768998100000002", "status": 1 } ], "total": 8, "page": 1, "page_size": 20 } } } }
          }
        }
      }
    },
    "/admin/v1/orders/{id}": {
      "get": {
        "tags": ["订单管理"],
        "summary": "订单详情（聚合：订单+状态日志+派单+价格+支付+结算）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "order": { "id": 8, "order_no": "DD20260818155131768998100000002", "status": 1 }, "status_logs": [], "dispatch_records": [], "price": null, "payment": null, "settlement": null } } } }
          },
          "404": { "description": "订单不存在 40401" }
        }
      }
    },
    "/admin/v1/orders/abnormal": {
      "get": {
        "tags": ["订单管理"],
        "summary": "异常订单列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "abnormal_type", "in": "query", "schema": { "type": "string", "enum": ["cancel", "payment", "dispatch"], "description": "空表示全部" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "user_id", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "driver_id", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "start_time", "in": "query", "schema": { "type": "string" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
    "/admin/v1/orders/{id}/cancel": {
      "post": {
        "tags": ["订单管理"],
        "summary": "后台取消订单（依赖 ordersvc）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrderCancelRequest" },
              "example": { "reason": "司机长时间未接单" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功" },
          "404": { "description": "订单不存在 40401" },
          "500": { "description": "ordersvc 不可用 50000" }
        }
      }
    },
    "/admin/v1/coupons": {
      "get": {
        "tags": ["优惠券"],
        "summary": "优惠券模板列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string", "description": "优惠券名称" } },
          { "name": "type", "in": "query", "schema": { "type": "integer", "description": "1 满减 2 折扣 3 立减" } },
          { "name": "status", "in": "query", "schema": { "type": "integer", "description": "1 草稿 2 启用 3 停用" } },
          { "name": "start_time", "in": "query", "schema": { "type": "string" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      },
      "post": {
        "tags": ["优惠券"],
        "summary": "新增优惠券模板（返回新 ID）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CouponSaveRequest" },
              "example": { "name": "新用户立减券", "type": 3, "face_value": "8.00", "discount": "1.00", "threshold_amount": "0.00", "total_count": 10000, "per_user_limit": 1, "valid_start_at": "2026-08-18 00:00:00", "valid_end_at": "2026-12-31 23:59:59", "status": 1 }
            }
          }
        },
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "code": 0, "message": "ok", "data": { "id": 1 } } } } },
          "400": { "description": "参数校验失败 40001" }
        }
      }
    },
    "/admin/v1/coupons/{id}": {
      "put": {
        "tags": ["优惠券"],
        "summary": "编辑优惠券模板",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CouponSaveRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功" },
          "404": { "description": "优惠券不存在 40401" }
        }
      }
    },
    "/admin/v1/coupons/{id}/disable": {
      "post": {
        "tags": ["优惠券"],
        "summary": "停用优惠券模板",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "成功" },
          "404": { "description": "不存在或已停用 40401" }
        }
      }
    },
    "/admin/v1/coupons/{id}/issue": {
      "post": {
        "tags": ["优惠券"],
        "summary": "发券",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CouponIssueRequest" },
              "example": { "target_type": "user", "target_config": "{\"user_ids\":[10001,10002]}" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功" },
          "400": { "description": "券未启用/已过期/参数错误 40001" },
          "404": { "description": "优惠券不存在 40401" },
          "500": { "description": "缺表 50000" }
        }
      }
    },
    "/admin/v1/coupon-issue-tasks": {
      "get": {
        "tags": ["优惠券"],
        "summary": "发券任务列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "coupon_id", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "running", "success", "partial_failed", "failed"] } },
          { "name": "start_time", "in": "query", "schema": { "type": "string" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
    "/admin/v1/price-rules": {
      "get": {
        "tags": ["计价规则"],
        "summary": "计价规则列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "city_code", "in": "query", "schema": { "type": "string" } },
          { "name": "car_type", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "integer" } }
        ],
