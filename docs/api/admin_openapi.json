  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "登录接口返回的 data.token"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "password", "real_name", "role"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "real_name": { "type": "string" },
          "role": { "type": "integer", "description": "1 超管 2 运营 3 客服" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "FreezeRequest": {
        "type": "object",
        "properties": {
          "reason": { "type": "string" },
          "remark": { "type": "string" }
        }
      },
      "AuditRequest": {
        "type": "object",
        "properties": {
          "remark": { "type": "string" }
        }
      },
      "OrderCancelRequest": {
        "type": "object",
        "properties": {
          "reason": { "type": "string" }
        }
      },
      "CouponSaveRequest": {
        "type": "object",
        "required": ["name", "type", "face_value", "discount", "threshold_amount", "total_count", "per_user_limit", "valid_start_at", "valid_end_at", "status"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "integer", "description": "1 满减 2 折扣 3 立减" },
          "face_value": { "type": "string", "example": "8.00" },
          "discount": { "type": "string", "example": "1.00" },
          "threshold_amount": { "type": "string", "example": "0.00" },
          "total_count": { "type": "integer", "format": "int64", "description": "0 表示不限量" },
          "per_user_limit": { "type": "integer" },
          "valid_start_at": { "type": "string", "example": "2026-08-18 00:00:00" },
          "valid_end_at": { "type": "string", "example": "2026-12-31 23:59:59" },
          "status": { "type": "integer", "description": "1 草稿 2 启用 3 停用" }
        }
      },
      "CouponIssueRequest": {
        "type": "object",
        "required": ["target_type", "target_config"],
        "properties": {
          "target_type": { "type": "string", "enum": ["user", "batch", "crowd"] },
          "target_config": { "type": "string", "description": "JSON 字符串，如 {\"user_ids\":[10001,10002]}" }
        }
      },
      "PriceRuleSaveRequest": {
        "type": "object",
        "required": ["name", "city_code", "car_type", "base_price", "base_distance_km", "per_km_price", "per_minute_price", "night_start_time", "night_end_time", "night_surcharge", "dynamic_max_factor", "status", "effective_at"],
        "properties": {
          "name": { "type": "string" },
          "city_code": { "type": "string", "example": "110100" },
          "car_type": { "type": "integer", "example": 1 },
          "base_price": { "type": "string", "example": "12.50" },
          "base_distance_km": { "type": "string", "example": "3.00" },
          "per_km_price": { "type": "string", "example": "2.40" },
          "per_minute_price": { "type": "string", "example": "0.50" },
          "night_start_time": { "type": "string", "example": "22:00:00" },
          "night_end_time": { "type": "string", "example": "06:00:00" },
          "night_surcharge": { "type": "string", "example": "1.20" },
          "dynamic_max_factor": { "type": "string", "example": "2.00" },
          "status": { "type": "integer", "description": "1 启用 2 停用" },
          "effective_at": { "type": "string", "example": "2026-08-20 00:00:00" },
          "expire_at": { "type": "string", "example": "2026-12-31 23:59:59" }
        }
      },
      "PromotionActivitySaveRequest": {
        "type": "object",
        "required": ["name", "type", "config", "start_at", "end_at", "status"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "integer" },
          "config": { "type": "string", "description": "JSON 字符串" },
          "start_at": { "type": "string" },
          "end_at": { "type": "string" },
          "status": { "type": "integer", "description": "1 草稿 2 运行中 3 已结束" }
        }
      },
      "PromotionActivityActionRequest": {
        "type": "object",
        "properties": {
          "publish_scope": { "type": "string" },
          "target_config": { "type": "string" }
        }
      },
      "ExportTaskRequest": {
        "type": "object",
        "required": ["export_type"],
        "properties": {
          "export_type": { "type": "string", "example": "orders" },
          "filters": { "type": "string", "description": "JSON 字符串" }
        }
      },
      "BlacklistRequest": {
        "type": "object",
        "required": ["target_type", "target_id", "reason"],
        "properties": {
          "target_type": { "type": "string", "enum": ["user", "driver", "device", "phone"] },
          "target_id": { "type": "integer", "format": "int64" },
          "reason": { "type": "string" }
        }
      },
      "BlacklistReleaseRequest": {
        "type": "object",
        "properties": {
          "reason": { "type": "string" }
        }
      }
    }
  },
  "security": [
    { "BearerAuth": [] }
  ]
}
